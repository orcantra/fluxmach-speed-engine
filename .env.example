# Fluxmach Speed Engine - Environment Variables Template
# Copy this file to .env and fill in the values

# Server Port (default :8080)
# PORT=:8080

# Server Information
SERVER_NAME="Fluxmach Edge Node 1"
LOCATION="New York, US"

# API Security Key. Leave blank to disable the key check entirely. Not a
# real secret if your frontend is public (NEXT_PUBLIC_* vars ship in the JS
# bundle) - it mainly deters casual abuse, not a determined attacker.
FLUXMACH_AUTH_KEY=long-random-secret

# CORS allowed origin. Defaults to "*"; set to your frontend's origin in
# production to stop other sites hotlinking /download and /upload.
# ALLOWED_ORIGIN=*
